{
  "name": "astro-template",
  "description": "",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "tsc && eslint --fix && stylelint --fix './src/**/*.{astro,scss}' && prettier --write './src/**/*.{astro,ts,tsx}'",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/ts-plugin": "^1.10.6",
    "astro": "^5.17.3",
    "astro-robots-txt": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playform/compress": "^0.2.1",
    "cssnano": "^7.1.2",
    "cssnano-preset-advanced": "^7.0.10",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sass-embedded": "^1.97.3",
    "stylelint": "^17.3.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3",
    "typescript-eslint": "^8.56.0"
  },
  "lint-staged": {
    "*.astro": [
      "eslint --fix --max-warnings 0",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix"
    ],
    "!(package*).json": [
      "prettier --write"
    ]
  }
}
